
@inherits LayoutComponentBase

<div class="page @ThemeClass">

    <!-- SIDEBAR -->
    <div class="sidebar">
        <NavMenu />
    </div>

    <!-- MAIN CONTENT -->
    <main>

        <!-- TOP HEADER -->
        <div class="top-row px-4 ccna-topbar">

            <div class="ccna-topbar-left">
                <span class="ccna-topbar-label">
                    CCNA PRACTICE HUB
                </span>
            </div>

            <!-- USER AREA AND THEME MENU -->
            <div class="ccna-profile-dropdown">

                <button type="button"
                        class="ccna-profile-trigger"
                        aria-label="User appearance settings">

                    <span class="ccna-user-avatar">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                        </svg>
                    </span>

                    <span class="ccna-user-greeting">
                        Hello, User!
                    </span>

                    <span class="ccna-dropdown-arrow">⌄</span>
                </button>

                <!-- HOVER MENU -->
                <div class="ccna-theme-menu">

                    <div class="ccna-theme-heading">
                        APPEARANCE
                    </div>

                    <div class="ccna-theme-description">
                        Choose your preferred theme
                    </div>

                    <button type="button"
                            class="ccna-theme-option"
                            @onclick='() => SetTheme("cyber")'>

                        <span class="ccna-theme-preview cyber-preview"></span>
                        <span>Cyber Dark</span>

                        @if (SelectedTheme == "cyber")
                        {
                            <span class="ccna-theme-check">✓</span>
                        }
                    </button>

                    <button type="button"
                            class="ccna-theme-option"
                            @onclick='() => SetTheme("purple")'>

                        <span class="ccna-theme-preview purple-preview"></span>
                        <span>Midnight Purple</span>

                        @if (SelectedTheme == "purple")
                        {
                            <span class="ccna-theme-check">✓</span>
                        }
                    </button>

                    <button type="button"
                            class="ccna-theme-option"
                            @onclick='() => SetTheme("slate")'>

                        <span class="ccna-theme-preview slate-preview"></span>
                        <span>Slate Grey</span>

                        @if (SelectedTheme == "slate")
                        {
                            <span class="ccna-theme-check">✓</span>
                        }
                    </button>

                    <button type="button"
                            class="ccna-theme-option"
                            @onclick='() => SetTheme("light")'>

                        <span class="ccna-theme-preview light-preview"></span>
                        <span>Light Mode</span>

                        @if (SelectedTheme == "light")
                        {
                            <span class="ccna-theme-check">✓</span>
                        }
                    </button>

                    
<button type="button"
        class="ccna-theme-option"
        @onclick='() => SetTheme("black")'>

    <span class="ccna-theme-preview black-preview"></span>
    <span>AMOLED Black</span>

    @if (SelectedTheme == "black")
    {
        <span class="ccna-theme-check">✓</span>
    }
</button>


                </div>
            </div>
        </div>

        <!-- PAGE CONTENT -->
        <article class="content px-4">
            @Body
        </article>

    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string SelectedTheme = "cyber";

    private string ThemeClass => $"ccna-theme-{SelectedTheme}";

    private void SetTheme(string theme)
    {
        SelectedTheme = theme;
    }
}
