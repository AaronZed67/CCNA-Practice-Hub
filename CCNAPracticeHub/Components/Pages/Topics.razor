
@page "/topics"

<PageTitle>CCNA Topics | CCNA Practice Hub</PageTitle>

<div class="mb-4">
    <span class="dashboard-eyebrow">
        QUESTION PRACTICE
    </span>

    <h1 class="mt-2">CCNA Exam Topics</h1>

    <p>
        Choose an exam domain and select a subtopic
        to practise your CCNA knowledge.
    </p>
</div>

<div class="row g-4">

    @foreach (var topic in ExamTopics)
    {
        <div class="col-12 col-lg-6 col-xl-4"
             @key="topic.Name">

            <div class="card h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start gap-2 mb-3">

                        <h5 class="card-title">
                            @topic.Name
                        </h5>

                        <span class="badge bg-primary">
                            @topic.Weight%
                        </span>
                    </div>

                    <p class="card-text">
                        @topic.Description
                    </p>

                    <button class="btn btn-outline-info w-100 mt-2"
                            @onclick="() => ToggleTopic(topic.Name)">

                        @(ExpandedTopic == topic.Name
                            ? "Hide Subtopics −"
                            : "View Subtopics +")

                    </button>

                    @if (ExpandedTopic == topic.Name)
                    {
                        <div class="mt-4">

                            <h6 class="mb-3">
                                Select a subtopic
                            </h6>

                            <div class="d-grid gap-2">

                                @foreach (var subtopic in topic.Subtopics)
                                {
                                    <button class="btn btn-outline-light text-start"
                                            disabled
                                            title="Practice questions coming soon">

                                        @subtopic

                                    </button>
                                }

                            </div>

                            <small class="d-block mt-3 text-muted">
                                Practice questions will be available soon.
                            </small>

                        </div>
                    }

                </div>
            </div>
        </div>
    }

</div>

@code {

    private string? ExpandedTopic;

    private void ToggleTopic(string topicName)
    {
        ExpandedTopic = ExpandedTopic == topicName
            ? null
            : topicName;
    }

    private List<ExamTopic> ExamTopics = new()
    {
        new(
            "Network Fundamentals",
            20,
            "Network devices, addressing, cabling and networking basics.",
            new()
            {
                "Network Devices",
                "IPv4 Addressing & Subnetting",
                "IPv6 Addressing",
                "Cabling & Interfaces",
                "TCP & UDP",
                "Wireless Fundamentals"
            }
        ),

        new(
            "Network Access",
            20,
            "Switching, VLANs, wireless networking and access technologies.",
            new()
            {
                "VLANs",
                "Trunking",
                "Spanning Tree Protocol",
                "EtherChannel",
                "Wireless Architecture",
                "Switch Port Security"
            }
        ),

        new(
            "IP Connectivity",
            25,
            "Routing tables, static routing and dynamic routing protocols.",
            new()
            {
                "Routing Tables",
                "Static Routing",
                "Default Routes",
                "OSPF",
                "Route Selection"
            }
        ),

        new(
            "IP Services",
            10,
            "Services supporting communication across networks.",
            new()
            {
                "DHCP",
                "DNS",
                "NAT",
                "NTP",
                "SNMP",
                "QoS"
            }
        ),

        new(
            "Security Fundamentals",
            15,
            "Network security concepts, threats and access control.",
            new()
            {
                "Security Threats",
                "Access Control Lists",
                "Authentication",
                "Device Hardening",
                "Wireless Security",
                "VPN Concepts"
            }
        ),

        new(
            "Automation and Programmability",
            10,
            "Network automation and programmable network technologies.",
            new()
            {
                "Network Automation",
                "REST APIs",
                "JSON",
                "Controller-Based Networking",
                "Configuration Management"
            }
        )
    };

    private record ExamTopic(
        string Name,
        int Weight,
        string Description,
        List<string> Subtopics
    );
}
