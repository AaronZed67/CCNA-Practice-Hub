            margin-bottom: 12px;
        }

        .topic-feedback p {
            line-height: 1.65;
        }

            .topic-feedback p:last-child {
                margin-bottom: 0;
            }

    .topic-feedback-good {
        color: #22c55e;
    }

    .topic-feedback-bad {
        color: #ef4444;
    }

    .topic-primary-button,
    .topic-secondary-button {
        display: inline-block;
        padding: 13px 20px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .topic-primary-button {
        color: #07111f;
        background: #22d3ee;
        border: none;
    }

        .topic-primary-button:hover:not(:disabled) {
            background: #67e8f9;
        }

        .topic-primary-button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    .topic-secondary-button {
        color: inherit;
        background: transparent;
        border: 1px solid rgba(148, 163, 184, 0.4);
    }

    .topic-results {
        text-align: center;
    }

        .topic-results .topic-kicker {
            margin-top: 0;
        }

    .topic-result-score {
        margin: 20px 0;
        font-size: 70px;
        font-weight: 800;
        color: #22d3ee;
    }

    .topic-result-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 25px;
    }

    @@media (max-width: 650px) {
        .topic-panel {
            padding: 18px;
        }

        .topic-quiz-page h1 {
            font-size: 26px;
        }

        .topic-question-text {
            font-size: 19px;
        }

        .topic-result-score {
            font-size: 55px;
        }
    }

</style>

@code {

    // Each topic quiz contains up to 10 questions.
    private const int QuestionsPerSession = 10;

    [SupplyParameterFromQuery(Name = "domain")]
    public string? Domain { get; set; }

    [SupplyParameterFromQuery(Name = "subtopic")]
    public string? Subtopic { get; set; }

    private List<Question> Questions = new();

    private int CurrentIndex;
    private int? SelectedAnswerIndex;
    private int Score;

    private bool AnswerSubmitted;
    private bool AnswerCorrect;
    private bool QuizFinished;
    private bool IsLoading = true;

    private string? ErrorMessage;

    private Question? CurrentQuestion =>
        CurrentIndex >= 0 && CurrentIndex < Questions.Count
            ? Questions[CurrentIndex]
            : null;

    private int ProgressPercentage =>
        Questions.Count == 0
            ? 0
            : (int)Math.Round(
                (double)(CurrentIndex + 1)
                / Questions.Count * 100);

    private int FinalPercentage =>
        Questions.Count == 0
            ? 0
            : (int)Math.Round(
                (double)Score
                / Questions.Count * 100);

    // Load whenever the requested domain or subtopic changes.
    protected override async Task OnParametersSetAsync()
    {
        await LoadQuestionsAsync();
    }

    private async Task LoadQuestionsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        Questions = new List<Question>();

        try
        {
            if (string.IsNullOrWhiteSpace(Domain) ||
                string.IsNullOrWhiteSpace(Subtopic))
            {
                ErrorMessage =
                    "Please choose a subtopic from the CCNA Topics page.";

                return;
            }

            await using var db =
                await DbFactory.CreateDbContextAsync();

            // Retrieve up to 10 random questions
            // for the selected domain and subtopic.
            Questions = await db.Questions
                .AsNoTracking()
                .Where(q =>
                    q.Domain == Domain &&
                    q.Subtopic == Subtopic)
                .OrderBy(q => EF.Functions.Random())
                .Take(QuestionsPerSession)
                .ToListAsync();

            // NEW: Shuffle the answer options for each
            // question after loading it from SQLite.
            //
            // AsNoTracking ensures these question objects
            // are not tracked for database updates.
            foreach (var question in Questions)
            {
                ShuffleAnswerOptions(question);
            }

            ResetQuizState();
        }
        catch (Exception)
        {
            Questions.Clear();

            ErrorMessage =
                "Unable to load questions from the database. " +
                "Please check the database connection.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    // NEW: Fisher-Yates answer shuffling.
    //
    // This method moves answer strings into random positions
    // and updates the correct-answer index to match.
    //
    // Example:
    // Before: SSH is answer B (index 1).
    // After:  SSH might become answer D (index 3).
    //
    // The stored database question is not changed.
    private static void ShuffleAnswerOptions(Question question)
    {
        if (question.Options is null ||
            question.Options.Count < 2)
        {
            return;
        }

        // Create a separate list of the answer choices.
        var shuffledOptions = question.Options.ToList();

        // Remember where the correct answer currently is.
        int correctIndex = question.CorrectAnswerIndex;

        // Shuffle the options using Fisher-Yates.
        for (int i = shuffledOptions.Count - 1; i > 0; i--)
        {
            int randomIndex = Random.Shared.Next(i + 1);

            // Swap the two options.
            (shuffledOptions[i], shuffledOptions[randomIndex]) =
                (shuffledOptions[randomIndex], shuffledOptions[i]);

            // Update the correct-answer index if it was
            // involved in the swap.
            if (correctIndex == i)
            {
                correctIndex = randomIndex;
            }
            else if (correctIndex == randomIndex)
            {
                correctIndex = i;
            }
        }

        // Store the shuffled choices for this quiz session.
        question.Options = shuffledOptions;

        // Point scoring to the correct new answer position.
        question.CorrectAnswerIndex = correctIndex;
    }

    private void ResetQuizState()
    {
        CurrentIndex = 0;
        SelectedAnswerIndex = null;
        Score = 0;

        AnswerSubmitted = false;
        AnswerCorrect = false;
        QuizFinished = false;
    }

    private void SelectAnswer(int index)
    {
        if (AnswerSubmitted || CurrentQuestion is null)
            return;

        if (index < 0 ||
            index >= CurrentQuestion.Options.Count)
            return;

        SelectedAnswerIndex = index;
    }

    private void SubmitAnswer()
    {
        if (CurrentQuestion is null ||
            SelectedAnswerIndex is null ||
            AnswerSubmitted)
            return;

        // CorrectAnswerIndex has already been updated
        // to reflect the shuffled answer positions.
        AnswerCorrect =
            SelectedAnswerIndex.Value ==
            CurrentQuestion.CorrectAnswerIndex;

        if (AnswerCorrect)
            Score++;

        AnswerSubmitted = true;
    }

    private void NextQuestion()
    {
        if (!AnswerSubmitted)
            return;

        if (CurrentIndex < Questions.Count - 1)
        {
            CurrentIndex++;
            SelectedAnswerIndex = null;
            AnswerSubmitted = false;
            AnswerCorrect = false;
        }
        else
        {
            QuizFinished = true;
        }
    }

    private string GetOptionClass(int index)
    {
        const string baseClass = "topic-option";

        if (AnswerSubmitted &&
            CurrentQuestion is not null)
        {
            // Highlight the correct shuffled option green.
            if (index == CurrentQuestion.CorrectAnswerIndex)
                return baseClass + " topic-option-correct";

            // Highlight an incorrect selection red.
            if (index == SelectedAnswerIndex)
                return baseClass + " topic-option-incorrect";
        }

        if (index == SelectedAnswerIndex)
            return baseClass + " topic-option-selected";

        return baseClass;
    }
}
