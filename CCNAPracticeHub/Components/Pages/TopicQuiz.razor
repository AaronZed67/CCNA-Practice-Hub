    }

    .topic-option-incorrect {
        border-color: #ef4444;
        background: rgba(239, 68, 68, 0.12);
    }

    .topic-option-letter {
        flex-shrink: 0;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 34px;
        height: 34px;
        border-radius: 7px;
        background: rgba(148, 163, 184, 0.14);
        font-weight: 700;
    }

    .topic-feedback {
        margin: 20px 0;
        padding: 18px;
        border: 1px solid rgba(34, 211, 238, 0.25);
        border-radius: 9px;
        background: rgba(34, 211, 238, 0.05);
    }

        .topic-feedback h3 {
