@page "/topic-quiz"
@rendermode InteractiveServer

@using CCNAPracticeHub.Data
@using CCNAPracticeHub.Models
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<CcnaDbContext> DbFactory

<PageTitle>Topic Quiz - CCNA Hub</PageTitle>

<div class="topic-quiz-page">

    <a class="topic-back-link" href="/topics">
        ← Back to CCNA Topics
    </a>

    <div class="topic-kicker">
        TOPIC PRACTICE
    </div>

    <h1>@(Subtopic ?? "Topic Quiz")</h1>

    <p class="topic-description">
        @Domain · Up to 10 random questions
    </p>

    @if (IsLoading)
    {
        <div class="topic-panel">
            Loading your questions...
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="topic-panel">
            <h2>Unable to load questions</h2>

            <p>@ErrorMessage</p>

            <button class="topic-primary-button"
                    @onclick="LoadQuestionsAsync">
                Try Again
            </button>
        </div>
    }
    else if (Questions.Count == 0)
    {
        <div class="topic-panel">

            <h2>No questions available yet</h2>

            <p>
                We haven't added any questions for
                this subtopic yet.
            </p>

            <a class="topic-secondary-button"
               href="/topics">
                Back to Topics
            </a>

        </div>
    }
    else if (QuizFinished)
    {
        <div class="topic-panel topic-results">

            <div class="topic-kicker">
                SESSION COMPLETE
            </div>

            <h2>Practice Complete!</h2>

            <div class="topic-result-score">
                @FinalPercentage%
            </div>

            <p>
                You answered @Score out of
                @Questions.Count questions correctly.
            </p>

            <div class="topic-result-actions">

                <button class="topic-primary-button"
                        @onclick="LoadQuestionsAsync">
                    Try Again — New Questions
                </button>

                <a class="topic-secondary-button"
                   href="/topics">
                    Choose Another Topic
                </a>

            </div>
        </div>
    }
    else if (CurrentQuestion is not null)
    {
        <div class="topic-panel">

            <div class="topic-question-top">

                <span>
                    QUESTION @(CurrentIndex + 1)
                    OF @Questions.Count
                </span>

                <span>
                    SCORE: @Score
                </span>

            </div>

            <div class="topic-progress-track">
                <div class="topic-progress-fill"
                     style="width: @(ProgressPercentage)%">
                </div>
            </div>

            <span class="topic-difficulty">
                @CurrentQuestion.Difficulty
            </span>

            <h2 class="topic-question-text">
                @CurrentQuestion.QuestionText
            </h2>

            <!-- SHUFFLED ANSWER OPTIONS -->

            <div class="topic-options">

                @for (int i = 0;
                      i < CurrentQuestion.Options.Count;
                      i++)
                {
                    int optionIndex = i;

                    <button type="button"
                            class="@GetOptionClass(optionIndex)"
                            disabled="@AnswerSubmitted"
                            @onclick="() => SelectAnswer(optionIndex)">

                        <span class="topic-option-letter">
                            @((char)('A' + optionIndex))
                        </span>

                        <span>
                            @CurrentQuestion.Options[optionIndex]
                        </span>

                    </button>
                }

            </div>

            <!-- ANSWER FEEDBACK -->
            @if (AnswerSubmitted)
            {
                <div class="topic-feedback">

                    <h3 class="@(AnswerCorrect
                                                ? "topic-feedback-good"
                                                : "topic-feedback-bad")">

                        @(AnswerCorrect
                            ? "✓ Correct Answer!"
                            : "✕ Incorrect Answer")

                    </h3>

                    @if (!AnswerCorrect)
                    {
                        <p>
                            <strong>Correct answer:</strong>
                            @CurrentQuestion.Options[
                                CurrentQuestion.CorrectAnswerIndex]
                        </p>
                    }

                    <p>
                        @CurrentQuestion.Explanation
                    </p>

                </div>

                <button class="topic-primary-button"
                        @onclick="NextQuestion">

                    @(CurrentIndex == Questions.Count - 1
                        ? "View Results"
                        : "Next Question →")

                </button>
            }
            else
            {
                <button class="topic-primary-button"
                        disabled="@(SelectedAnswerIndex is null)"
                        @onclick="SubmitAnswer">
                    Submit Answer
                </button>
            }

        </div>
    }

</div>

<style>

    .topic-quiz-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px 8px 60px;
        color: inherit;
    }

    .topic-back-link {
        color: #22d3ee;
        text-decoration: none;
        font-size: 14px;
    }

        .topic-back-link:hover {
            text-decoration: underline;
        }

    .topic-kicker {
        margin-top: 24px;
        margin-bottom: 10px;
        color: #22d3ee;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .topic-quiz-page h1 {
        font-size: 32px;
        font-weight: 750;
        margin: 8px 0;
    }

