    .topic-difficulty {
        display: inline-block;
        margin-bottom: 15px;
        padding: 4px 10px;
        border: 1px solid rgba(34, 211, 238, 0.2);
        border-radius: 5px;
        color: #22d3ee;
        background: rgba(34, 211, 238, 0.07);
        font-size: 12px;
    }

    .topic-question-text {
        font-size: 22px;
        line-height: 1.5;
        font-weight: 650;
        margin-bottom: 24px;
    }

    .topic-options {
        display: grid;
        gap: 12px;
        margin-bottom: 24px;
    }

    .topic-option {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        padding: 15px;
        border: 1px solid var(--border-color, #263650);
        border-radius: 8px;
        background: transparent;
        color: inherit;
        text-align: left;
        font: inherit;
        cursor: pointer;
        transition: 0.15s ease;
    }

        .topic-option:hover:not(:disabled) {
            border-color: #22d3ee;
            background: rgba(34, 211, 238, 0.07);
        }

        .topic-option:focus-visible {
            outline: 2px solid #22d3ee;
            outline-offset: 3px;
        }

        .topic-option:disabled {
